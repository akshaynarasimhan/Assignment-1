# ╔══════════════════════════════════════════════════════════════════╗
# ║  LeadGen Engine — Environment Configuration                      ║
# ║  Copy this file to .env and fill in only the keys you have.     ║
# ║  The app works with ZERO keys set (free sources only).           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Optional: SerpAPI (Paid Google search proxy) ─────────────────────────────
# Free tier: 100 searches/month  |  https://serpapi.com
# SERPAPI_KEY=your_key_here

# ── Optional: Hunter.io (Email finder) ───────────────────────────────────────
# Free tier: 25 searches/month  |  https://hunter.io
# HUNTER_API_KEY=your_key_here

# ── Optional: Proxycurl (LinkedIn enrichment) ────────────────────────────────
# Paid only (~$0.01/credit)  |  https://nubela.co/proxycurl
# PROXYCURL_API_KEY=your_key_here

# ── Optional: OpenAI (LLM fallback for ambiguous titles) ─────────────────────
# Paid  |  https://platform.openai.com/api-keys
# Recommend: gpt-4o-mini (cheapest)
# OPENAI_API_KEY=your_key_here

# ── Optional: Ollama (Free local LLM) ────────────────────────────────────────
# Install: https://ollama.com  |  run: ollama pull llama3.2:1b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# ── Scraper tuning ────────────────────────────────────────────────────────────
# REQUEST_TIMEOUT=15          # seconds for plain HTTP requests
# PLAYWRIGHT_TIMEOUT=20000    # ms for JS-rendered pages
# USE_PLAYWRIGHT=true         # set false to disable Playwright entirely
# DDG_DELAY=2.0               # seconds between DuckDuckGo requests

# ── LLM budget cap ────────────────────────────────────────────────────────────
# 0 = LLM completely disabled (default — all rule-based)
# LLM_MAX_CALLS_PER_SESSION=0
